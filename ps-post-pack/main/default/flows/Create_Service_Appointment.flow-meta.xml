    <formulas>
        <name>DeviceCheckSummary</name>
        <dataType>String</dataType>
        <expression>&quot;Your remote device check has been successfully scheduled. Below is a summary of your appointment and your most recent device information.&quot;
&amp; BR() &amp; BR() &amp;
&quot;Appointment Reference: &quot; &amp; {!Create_Service_Appointment.AppointmentNumber}
&amp; BR() &amp;
&quot;Appointment Date: &quot; &amp; TEXT({!Create_Service_Appointment.EarliestStartTime})
&amp; BR() &amp;
&quot;Device Model: &quot; &amp; {!Product_Name}
&amp; BR() &amp;
&quot;Manufacturer: &quot; &amp; {!Manufacturer}
&amp; BR() &amp;
&quot;Most Recent Transmission: &quot; &amp; {!Transmission_Status}

&amp; BR() &amp; BR() &amp; 
&quot;We noticed a small change in your recent health readings compared to your usual baseline. There’s no immediate cause for concern, but we want to make sure you continue feeling your best.&quot;
&amp; BR() &amp;
&quot;If you experience chest pain, trouble breathing, dizziness, or anything that feels unusual, please seek urgent care right away.&quot;
&amp; BR() &amp; BR() &amp;
&quot;Would you like me to help you schedule a quick follow‑up appointment with your clinician?&quot;</expression>
    </formulas>
    <formulas>
        <name>DueDate</name>
        <dataType>DateTime</dataType>
        <expression>{!StartDate} + 1</expression>
    </formulas>
    <formulas>
        <name>f_CleanJson</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
  SUBSTITUTE(
    SUBSTITUTE({!OutputJS}, &quot; &quot;, &quot;&quot;),
  CHR(10), &quot;&quot;),
CHR(13), &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>Manufacturer</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS({!f_CleanJson}, &apos;&quot;Manufacturer&quot;:&quot;&apos;),
  MID(
    {!f_CleanJson},
    /* start position, immediately after &quot;Manufacturer&quot;:&quot; */
    FIND(&apos;&quot;Manufacturer&quot;:&quot;&apos;, {!f_CleanJson}) + 16,
    /* length = position of very next quote after the value - start */
    FIND(
      &apos;&quot;&apos;,
      {!f_CleanJson},
      FIND(&apos;&quot;Manufacturer&quot;:&quot;&apos;, {!f_CleanJson}) + 16
    )
    -
    (FIND(&apos;&quot;Manufacturer&quot;:&quot;&apos;, {!f_CleanJson}) + 16)
  ),
  &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Product_Name</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS({!OutputJS}, &apos;&quot;Product_Name&quot;&apos;),
  MID(
    {!OutputJS},
    /* start at the first quote AFTER the colon that follows &quot;Product_Name&quot; */
    FIND(
      &apos;&quot;&apos;,
      {!OutputJS},
      FIND(&apos;:&apos;, {!OutputJS}, FIND(&apos;&quot;Product_Name&quot;&apos;, {!OutputJS}))
    ) + 1,
    /* length = next quote after start minus start */
    FIND(
      &apos;&quot;&apos;,
      {!OutputJS},
      FIND(
        &apos;&quot;&apos;,
        {!OutputJS},
        FIND(&apos;:&apos;, {!OutputJS}, FIND(&apos;&quot;Product_Name&quot;&apos;, {!OutputJS}))
      ) + 1
    )
    -
    (
      FIND(
        &apos;&quot;&apos;,
        {!OutputJS},
        FIND(&apos;:&apos;, {!OutputJS}, FIND(&apos;&quot;Product_Name&quot;&apos;, {!OutputJS}))
      ) + 1
    )
  ),
  &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Transmission_Status</name>
        <dataType>String</dataType>
        <expression>IF(
  CONTAINS({!f_CleanJson}, &apos;&quot;Transmission_Status&quot;:&quot;&apos;),
  MID(
    {!f_CleanJson},
    FIND(&apos;&quot;Transmission_Status&quot;:&quot;&apos;, {!f_CleanJson}) + 23,
    FIND(
      &apos;&quot;&apos;,
      {!f_CleanJson},
      FIND(&apos;&quot;Transmission_Status&quot;:&quot;&apos;, {!f_CleanJson}) + 23
    ) -
    (FIND(&apos;&quot;Transmission_Status&quot;:&quot;&apos;, {!f_CleanJson}) + 23)
  ),
  &quot;&quot;
)</expression>
    </formulas>
