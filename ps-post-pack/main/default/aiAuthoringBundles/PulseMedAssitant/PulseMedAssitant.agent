system:
    instructions: "You are an AI Agent."
    messages:
        welcome: |
            Hi, I'm an AI service assistant. How can I help you?
        error: "Sorry, it looks like something has gone wrong."

config:
    agent_label: "PulseMedAssitant"
    agent_template: "SvcCopilotTmpl__AgentforceServiceAgent"
    developer_name: "PulseMedAssitant"
    description: "Deliver personalized customer interactions with an autonomous AI agent. Agentforce Service Agent intelligently supports your customers with common inquiries and escalates complex issues."

access:
    default_agent_user: "eagent1787224813402@test.com"


variables:
    contactId: linked string
        source: @MessagingSession.Contact_Id__c
        description: "Contact ID from the Messaging Session record"
    selectedDate: mutable string
        description: "Date selected by patient for remote device check"

start_agent agent_router:
    label: "Agent Router"
    description: "Welcome the user and determine the appropriate subagent based on user input"
    model_config:
        model: "model://sfdc_ai__DefaultEinsteinHyperClassifier"
    reasoning:
        instructions: ->
            | Select the best tool to call based on conversation history and user's intent.
        actions:
            go_to_Pacemaker_Guide_Info: @utils.transition to @subagent.Pacemaker_Guide_Info
            go_to_Patient_Post_Implant_Support: @utils.transition to @subagent.Patient_Post_Implant_Support

subagent Pacemaker_Guide_Info:
    label: "Pacemaker Guide Info"
    description: "Your job is to assist enquiry about Pacemaker Options and Process, Pacemaker FDA-Approved/Cleared, Pacemaker Warranty Duration and Warranty Coverage,setup Remote Monitor App and display the information."
    reasoning:
        instructions: ->
            | When customer ask about Pacemaker Options and Process, Pacemaker FDA-Approved/Cleared, pacemaker warranty duration and warranty coverage, setup Remote Monitor App then run the 'PacemakerDetailsForGuest' action and display the exact prompt response. DO NOT SKIP OR HIDE ANY STPES.DO NOT ASK ANY FOLLOW UP QUESTIONS.
        actions:
            PacemakerDetailsForGuest: @actions.PacemakerDetailsForGuest
                with "Input:Question" = ...
                with citationMode = ...


    actions:
        PacemakerDetailsForGuest:
            description: |
                When patient ask a question related to Pacemaker Types/Process, Pacemaker FDA-approved/cleared ,Warranty coverage, Demo of Remote Monitor App then run this action and display the information to patients.
            label: "PacemakerDetailsForGuest"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "PacemakerDetailsForGuest"
            target: "generatePromptResponse://PacemakerDetailsForGuest"
                        
            inputs:
                "Input:Question": string
                    description: |
                      Patient Question 
                    label: "Question"
                    is_required: True
                    is_user_input: False
                "citationMode": string
                    description: |
                      Select Citation Mode
                    label: "Citation Mode"
                    is_required: False
                    is_user_input: False
                        
            outputs:
                "promptResponse": string
                    description: |
                      The prompt response generated by the action based on the specified prompt and input.
                    label: "Prompt Response"
                    is_displayable: True
                    filter_from_agent: False
                "citations": object
                    description: |
                      The prompt citation response generated by the action based on the specified prompt and input.
                    label: "Citations"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationOutput"



subagent Patient_Post_Implant_Support:
    label: "Patient Post Implant Support"
    description: "Support for patients after an implant, including home monitor setup, warranty/coverage for implanted devices and monitors, post-implant precautions, troubleshooting and helping to schedule appointment for remote device support and and summarizing  last 6 months information for the primary care doctor."
    reasoning:
        instructions: ->
            | When customer ask about 'HELP ME SET UP THE HOME MONITOR.' then run the 'HomeMonitorSetupGuide' action and pass the input variable RequestType as 'HomeMonitor' and pass the AccountId as coming from Messaging session record Contact_Id__c, and pass the Question as user asked question and display the  exact prompt response. DO NOT SKIP OR HIDE ANY STPES.DO NOT ASK ANY FOLLOW UP QUESTIONS.
            | When customer ask about WHAT’S THE WARRANTY/COVERAGE FOR MY IMPLANTED DEVICE AND MONITOR  then run the 'WarrantyDurationDetails' action and pass the input variable RequestType as 'WarrantyCoverage' and pass the AccountId as coming from Messaging session record Contact_Id__c, and pass the Question as user asked question and display the  exact prompt response. DO NOT SKIP OR HIDE ANY STPES.DO NOT ASK ANY FOLLOW UP QUESTIONS.
            | When customer ask exactly like 'WHAT PRECAUTIONS SHOULD I TAKE AFTER IMPLANT?' then run 'Post Implant Care' and pass Question as user asked question and display the  exact prompt response.
            | When customer ask 'MY MONITOR ISN’T TRANSMITTING—HOW DO I TROUBLESHOOT?' then run 'Monitor Troubleshoot Support' and pass Question as user asked question and pass the input variable RequestType as 'MonitorTransmitting' and pass the accountId as coming from Messaging session record Contact_Id__c and display the  exact prompt response.
            |When customer ask about summarize my last 6 months primary doctor care  then run the 'PatientSummary60Days' action and pass the input variables RequestType as 'SummarizePrimaryCareDoctor' , Id as coming from Messaging session record Contact_Id__c, Question as patient asked question and display the  EXACT prompt response in paragraph. DO NOT ADD ANY EXTRA WORDS OR ANY EXTRA INFORMATION. DO NOT ASK ANY FOLLOW UP QUESTION
            |When customer ask 'BOOK AN APPOINTMENT WITH MY CARDIOLOGIST' then run 'Cardiologist Appointment' and pass the contactId as coming from Messaging session record Contact_Id__c and display the message as is .
            | When customer ask 'CAN YOU SCHEDULE A REMOTE DEVICE CHECK?' then run 'Appointment Date Suggestion' and pass 'DATE' as Input and display the available dates to the customer. If customer selects any one of the available dates then store the selected date and run 'Create Service Appointment' passing the user provided date as 'StartDate' and pass the contactId as coming from Messaging session record Contact_Id__c and display the message as is.
            | When customer says 'Yes' to scheduling a quick follow-up appointment with your clinician (in response to an abnormal readings alert), then run 'Abnormal Readings Alert' and pass the contactId as coming from Messaging session record Contact_Id__c, and display the message as is
            |
        actions:
            HomeMonitorSetupGuide: @actions.HomeMonitorSetupGuide
                with "Input:RequestType" = "HomeMonitor"
                with "Input:AccountId" = @variables.contactId
                with "Input:Question" = ...
                with citationMode = ...
            WarrantyDurationDetails: @actions.WarrantyDurationDetails
                with "Input:AccountId" = @variables.contactId
                with "Input:Question" = ...
                with "Input:RequestType" = "WarrantyCoverage"
                with citationMode = ...
            Post_Implant_Care: @actions.Post_Implant_Care
                with "Input:Question" = ...
                with citationMode = ...
            Monitor_Troubleshoot_Support: @actions.Monitor_Troubleshoot_Support
                with "Input:Question" = ...
                with "Input:requestType" = "MonitorTransmitting"
                with "Input:accountId" = @variables.contactId
                with citationMode = ...
            PatientSummary60Days: @actions.PatientSummary60Days
                with "Input:RequestType" = "SummarizePrimaryCareDoctor"
                with "Input:Id" = @variables.contactId
                with "Input:Question" = ...
                with citationMode = ...
            Cardiologist_Appointment: @actions.Cardiologist_Appointment
                with contactId = @variables.contactId
            Appointment_Date_Suggestion: @actions.Appointment_Date_Suggestion
                with Input = ...
            Create_Service_Appointment: @actions.Create_Service_Appointment
                with StartDate = ...
                with contactId = @variables.contactId
            Abnormal_Readings_Alert: @actions.Abnormal_Readings_Alert
                with contactId = @variables.contactId


    actions:
        HomeMonitorSetupGuide:
            description: |
                HELP ME SET UP THE HOME MONITOR and WARRANTY/COVERAGE FOR MY IMPLANTED DEVICE AND MONITOR
            label: "HomeMonitorSetupGuide"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "HomeMonitorSetupGuide"
            target: "generatePromptResponse://HomeMonitorSetupGuide"
                                                                                                                                                                                                                        
            inputs:
                "Input:RequestType": string
                    description: |
                      Always pass the RequestType
                    label: "RequestType"
                    is_required: True
                    is_user_input: False
                "Input:AccountId": string
                    description: |
                      Pass the Contact Id Messaging Session Record
                    label: "AccountId"
                    is_required: True
                    is_user_input: False
                "Input:Question": string
                    description: |
                      Patient Question
                    label: "Question"
                    is_required: True
                    is_user_input: False
                "citationMode": string
                    description: |
                      Select Citation Mode
                    label: "Citation Mode"
                    is_required: False
                    is_user_input: False
                                                                                                                                                                                                                        
            outputs:
                "promptResponse": string
                    description: |
                      The prompt response generated by the action based on the specified prompt and input.
                    label: "Prompt Response"
                    is_displayable: True
                    filter_from_agent: False
                "citations": object
                    description: |
                      The prompt citation response generated by the action based on the specified prompt and input.
                    label: "Citations"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationOutput"
        WarrantyDurationDetails:
            description: |
                When patient ask about warranty/coverage for implanted device and monitor then execute this action and display the response
            label: "WarrantyDurationDetails"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "WarrantyDurationDetails"
            target: "generatePromptResponse://WarrantyDurationDetails"
                                                                                                                                                                                                
            inputs:
                "Input:AccountId": string
                    description: |
                      Id of the Record
                    label: "AccountId"
                    is_required: True
                    is_user_input: False
                "Input:Question": string
                    description: |
                      Patient Question
                    label: "Question"
                    is_required: True
                    is_user_input: False
                "Input:RequestType": string
                    description: |
                      Pass the RequestType
                    label: "RequestType"
                    is_required: True
                    is_user_input: False
                "citationMode": string
                    description: |
                      Select Citation Mode
                    label: "Citation Mode"
                    is_required: False
                    is_user_input: False
                                                                                                                                                                                                
            outputs:
                "promptResponse": string
                    description: |
                      The prompt response generated by the action based on the specified prompt and input.
                    label: "Prompt Response"
                    is_displayable: True
                    filter_from_agent: False
                "citations": object
                    description: |
                      The prompt citation response generated by the action based on the specified prompt and input.
                    label: "Citations"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationOutput"
        Post_Implant_Care:
            description: |
                This agent action is used to help patients understand the precautions they need to follow after an implant.
            label: "Post Implant Care"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "Post_Implant_Care"
            target: "generatePromptResponse://Post_Implant_Care"
                                                                                                                                                                        
            inputs:
                "Input:Question": string
                    description: |
                      input Question from Agent
                    label: "Question"
                    is_required: True
                    is_user_input: False
                "citationMode": string
                    description: |
                      Select Citation Mode
                    label: "Citation Mode"
                    is_required: False
                    is_user_input: False
                                                                                                                                                                        
            outputs:
                "promptResponse": string
                    description: |
                      The prompt response generated by the action based on the specified prompt and input.
                    label: "Prompt Response"
                    is_displayable: True
                    filter_from_agent: False
                "citations": object
                    description: |
                      The prompt citation response generated by the action based on the specified prompt and input.
                    label: "Citations"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationOutput"
        Monitor_Troubleshoot_Support:
            description: |
                This agent action is used to check the patient's pacemaker transmission and help troubleshoot the device.
            label: "Monitor Troubleshoot Support"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "Monitor_Troubleshoot_Support"
            target: "generatePromptResponse://Monitor_Troubleshoot_Support"
                                                                                                                                                
            inputs:
                "Input:Question": string
                    description: |
                      input Question
                    label: "Question"
                    is_required: True
                    is_user_input: False
                "Input:requestType": string
                    description: |
                      requestType
                    label: "requestType"
                    is_required: True
                    is_user_input: False
                "Input:accountId": string
                    description: |
                      accountId
                    label: "accountId"
                    is_required: True
                    is_user_input: False
                "citationMode": string
                    description: |
                      Select Citation Mode
                    label: "Citation Mode"
                    is_required: False
                    is_user_input: False
                                                                                                                                                
            outputs:
                "promptResponse": string
                    description: |
                      The prompt response generated by the action based on the specified prompt and input.
                    label: "Prompt Response"
                    is_displayable: True
                    filter_from_agent: False
                "citations": object
                    description: |
                      The prompt citation response generated by the action based on the specified prompt and input.
                    label: "Citations"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationOutput"
        PatientSummary60Days:
            description: |
                If patient ask about summarize my last 6 months for my primary care doctor then execute this action and display the response.
            label: "PatientSummary60Days"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "PatientSummary60Days"
            target: "generatePromptResponse://PatientSummary60Days"
                                                                                                                        
            inputs:
                "Input:RequestType": string
                    description: |
                      Pass the RequestType
                    label: "RequestType"
                    is_required: True
                    is_user_input: False
                "Input:Id": string
                    description: |
                      If of the Record
                    label: "Id"
                    is_required: True
                    is_user_input: False
                "Input:Question": string
                    description: |
                      Patient Question
                    label: "Question"
                    is_required: True
                    is_user_input: False
                "citationMode": string
                    description: |
                      Select Citation Mode
                    label: "Citation Mode"
                    is_required: False
                    is_user_input: False
                                                                                                                        
            outputs:
                "promptResponse": string
                    description: |
                      The prompt response generated by the action based on the specified prompt and input.
                    label: "Prompt Response"
                    is_displayable: True
