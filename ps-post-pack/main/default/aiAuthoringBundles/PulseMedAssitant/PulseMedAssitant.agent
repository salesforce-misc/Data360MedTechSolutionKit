                "citations": object
                    description: |
                      The prompt citation response generated by the action based on the specified prompt and input.
                    label: "Citations"
                    is_displayable: False
                    filter_from_agent: False
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationOutput"
        Cardiologist_Appointment:
            description: |
                This agent action is used to create a task for the clinic care coordinator for a follow up
            label: "Cardiologist Appointment"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "Cardiologist_Appointment"
            target: "flow://Cardiologist_Appointment"
                                                                                                
            inputs:
                "contactId": string
                    description: |
                      contact Id from messaging Session
                    label: "contactId"
                    is_required: True
