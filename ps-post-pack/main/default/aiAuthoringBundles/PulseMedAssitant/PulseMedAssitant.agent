            outputs:
                "output": string
                    description: |
                      Available Appointment Dates
                    label: "output"
                    is_displayable: True
                    filter_from_agent: False
        Create_Service_Appointment:
            description: |
                This agent action is used to create a appointment for remote device check and provide the summary of the patient device summary
            label: "Create Service Appointment"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "Create_Service_Appointment"
            target: "flow://Create_Service_Appointment"
                                                
            inputs:
                "StartDate": object
                    description: |
                      Appointment schedule date selected by patient 
                    label: "StartDate"
                    is_required: True
                    is_user_input: False
                    complex_data_type_name: "lightning__dateTimeStringType"
                "contactId": string
                    description: |
                      contactId of the patient
                    label: "contactId"
                    is_required: True
                    is_user_input: False
                                                
            outputs:
                "RemoteDeviceSummary": string
                    description: |
                      Overall summary
                    label: "RemoteDeviceSummary"
                    is_displayable: True
                    filter_from_agent: False
        Abnormal_Readings_Alert:
            description: |
                This agent action is used to create a appointment whenever the readings are quite abnormal inorder to safeguard the patient
            label: "Abnormal Readings Alert"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "Abnormal_Readings_Alert"
            target: "flow://Abnormal_Readings_Alert"
                        
            inputs:
                "contactId": string
                    description: |
                      contactId
                    label: "contactId"
                    is_required: True
                    is_user_input: False
                        
            outputs:
                "AppointmentSummary": string
                    description: |
                      Appointment Summary 
                    label: "AppointmentSummary"
                    is_displayable: True
                    filter_from_agent: False
