            outputs:
                "OutputMessage": string
                    description: |
                      Summary of the referral task
                    label: "OutputMessage"
                    is_displayable: True
                    filter_from_agent: False
        Appointment_Date_Suggestion:
            description: |
                This agent action is used to suggest appointment date for the patient's remote device check
            label: "Appointment Date Suggestion"
            require_user_confirmation: False
            include_in_progress_indicator: False
            source: "Appointment_Date_Suggestion"
            target: "flow://Appointment_Date_Suggestion"
                                                                        
            inputs:
                "Input": string
                    description: |
                      Input
                    label: "Input"
                    is_required: False
